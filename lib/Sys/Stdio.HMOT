Package Sys::Stdio;

Class
Cout
{
    Public
    {
        Cout
        ()
        {
        }

        I32
        expect
        fmt : Char*
        ()
        {
            Return 0;
        }

        I32
        write
        value : Char*
        ()
        {
            Return cmotive_sys_stdio_print(value);
        }
    }
};

Class
Cin
{
    Public
    {
        I32
        expect
        fmt : Char*
        ()
        {
            Return 0;
        }

        I32
        read
        ptr : Void*
        ()
        {
            Return 0;
        }
    }
};

I32
print
value : Char*
()
{
    Return cmotive_sys_stdio_print(value);
}

I32
println
value : Char*
()
{
    Return cmotive_sys_stdio_println(value);
}


I32
puts
value : Char*
()
{
    Return cmotive_sys_stdio_puts(value);
}

I32
putchar
ch : I32
()
{
    Return cmotive_sys_stdio_putchar(ch);
}

I32
flush
()
{
    Return cmotive_sys_stdio_flush();
}
