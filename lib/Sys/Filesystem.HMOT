Package Sys::Filesystem;

Boolean
exists
path : Char*
()
{
    Return cmotive_sys_filesystem_exists(path);
}

Boolean
isFile
path : Char*
()
{
    Return cmotive_sys_filesystem_is_file(path);
}

Boolean
isDirectory
path : Char*
()
{
    Return cmotive_sys_filesystem_is_directory(path);
}

I32
mkdir
path : Char*
()
{
    Return cmotive_sys_filesystem_mkdir(path);
}

I32
remove
path : Char*
()
{
    Return cmotive_sys_filesystem_remove(path);
}

I32
rename
old_path : Char*
new_path : Char*
()
{
    Return cmotive_sys_filesystem_rename(old_path, new_path);
}

I64
size
path : Char*
()
{
    Return cmotive_sys_filesystem_size(path);
}

Char*
currentPath
()
{
    Return cmotive_sys_filesystem_current_path();
}
