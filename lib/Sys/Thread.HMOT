Package Sys::Thread;

Void*
start
entry : Void*
userdata : Void*
()
{
    Return cmotive_sys_thread_start(entry, userdata);
}

I32
join
handle : Void*
()
{
    Return cmotive_sys_thread_join(handle);
}

I32
detach
handle : Void*
()
{
    Return cmotive_sys_thread_detach(handle);
}

Void*
current
()
{
    Return cmotive_sys_thread_current();
}

Void
sleepMs
milliseconds : U32
()
{
    cmotive_sys_thread_sleep_ms(milliseconds);
    Return;
}

I32
yield
()
{
    Return cmotive_sys_thread_yield();
}
