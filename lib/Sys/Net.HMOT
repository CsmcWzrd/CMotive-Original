Package Sys::Net;

I32
socketTcpIPv4
()
{
    Return cmotive_sys_net_socket_tcp_ipv4();
}
I32
socketTcpIPv6
()
{
    Return cmotive_sys_net_socket_tcp_ipv6();
}
I32
socketUdpIPv4
()
{
    Return cmotive_sys_net_socket_udp_ipv4();
}
I32
socketUdpIPv6
()
{
    Return cmotive_sys_net_socket_udp_ipv6();
}
I32
socketRawIPv4
()
{
    Return cmotive_sys_net_socket_raw_ipv4();
}
I32
socketRawIPv6
()
{
    Return cmotive_sys_net_socket_raw_ipv6();
}
I32
socketIcmpIPv4
()
{
    Return cmotive_sys_net_socket_icmp_ipv4();
}
I32
socketIcmpIPv6
()
{
    Return cmotive_sys_net_socket_icmp_ipv6();
}
I32
socketClose
fd : I32
()
{
    Return cmotive_sys_net_socket_close(fd);
}
