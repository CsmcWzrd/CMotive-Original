PYTHON ?= python3
PREFIX ?= /usr/local
BUILD_DIR ?= build
BIN_DIR := $(BUILD_DIR)/bin
TOOLS := cmotive cmotivepp cmotive++

.PHONY: all clean install test package
all: $(TOOLS:%=$(BIN_DIR)/%)

$(BIN_DIR):
	mkdir -p $(BIN_DIR)

$(BIN_DIR)/cmotive: tools/cmotive.py | $(BIN_DIR)
	cp tools/cmotive.py $@
	chmod +x $@

$(BIN_DIR)/cmotivepp: tools/cmotivepp.py | $(BIN_DIR)
	cp tools/cmotivepp.py $@
	chmod +x $@

$(BIN_DIR)/cmotive++: $(BIN_DIR)/cmotive | $(BIN_DIR)
	cp $(BIN_DIR)/cmotive $@
	chmod +x $@

test: all
	$(PYTHON) tests/run_tests.py --bin $(BIN_DIR)

package: all
	$(PYTHON) scripts/package_release.py --root . --out dist

install: all
	mkdir -p $(DESTDIR)$(PREFIX)/bin
	cp $(BIN_DIR)/cmotive $(DESTDIR)$(PREFIX)/bin/cmotive
	cp $(BIN_DIR)/cmotivepp $(DESTDIR)$(PREFIX)/bin/cmotivepp
	cp $(BIN_DIR)/cmotive++ $(DESTDIR)$(PREFIX)/bin/cmotive++

clean:
	rm -rf $(BUILD_DIR) dist

# Linux: cc/clang/gcc linker front-end, ld-compatible ELF output.
